---
type Props = { caption?: string; src?: string; title?: string };

const { caption, src } = Astro.props;

const videoid = src?.match(/https:\/\/youtu\.be\/([a-zA-Z0-9\-_]+)\??.*/)?.[1];

if (src && !videoid) {
  throw new Error("failed to parse videoid");
}

const contextId = `video-context-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="yt-container" data-video-context={contextId}>
  <div class="wrapper">
    <slot />
    {
      videoid && (
        <lite-youtube
          videoid={videoid}
          autoload
          posterquality="default"
          params="enablejsapi=1"
        />
      )
    }
  </div>
  <div class="caption">
    {caption}
    <slot name="caption" />
  </div>
</div>

<script>
  // クライアントサイドでのみlite-youtubeをimport
  import('@justinribeiro/lite-youtube/lite-youtube.js').then(() => {
    // 全てのlite-youtube要素にイベントリスナーを追加
    document.querySelectorAll('lite-youtube').forEach((liteYoutube) => {
      liteYoutube.addEventListener('liteYoutubeIframeLoaded', ((e: CustomEvent) => {
        const target = e.target as HTMLElement;
        if (!target.shadowRoot) return;

        const iframe = target.shadowRoot.querySelector('iframe');
        if (!iframe) return;

        // lite-youtube要素にiframe参照を保存
        (liteYoutube as any).__iframe = iframe;

        console.log('YouTube iframe loaded and stored');
      }) as EventListener);
    });
  });
</script>

<style>
  /* Tailwind v4 preflight resets `padding` on `*`, and that light-DOM rule
     beats lite-youtube's own shadow-DOM `:host` padding-bottom (its aspect-ratio
     hack), collapsing the player to 0 height. Restore it here. */
  lite-youtube {
    padding-bottom: calc(100% / (16 / 9));
  }

  .yt-container {
    margin-inline: auto;
    max-width: 560px;
    margin-block: 1rem;
    & > .wrapper {
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 16 / 9;
      max-width: 560px;
    }
  }
  .caption {
    margin-top: 0.5rem;
    color: var(--fg-weak);
    font-size: 0.9em;
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
    word-break: auto-phrase;
  }
</style>
