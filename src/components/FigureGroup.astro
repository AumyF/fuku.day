---
type Props = { caption?: string };

const { caption } = Astro.props;
---

<div class="mx-auto my-4 max-w-full">
  <div class="flex flex-wrap gap-2 [&>img]:h-auto [&>img]:max-w-full [&>img]:min-w-[min(100%,280px)] [&>img]:grow [&>img]:shrink-0 [&>img]:basis-[280px]">
    <slot />
  </div>
  <div class="mt-2 text-center text-[0.9em] leading-normal text-balance [word-break:auto-phrase] text-[var(--fg-weak)]">
    {caption}
    <slot name="caption" />
  </div>
</div>
