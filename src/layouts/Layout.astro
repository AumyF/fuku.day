---
import Header from "./components/header.astro";
import Footer from "./components/footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, image } = Astro.props;
---

<!doctype html>
<html
  class="leading-loose [container-type:inline-size] [container-name:document] bg-neutral-200 text-black [scrollbar-color:black_white] [scrollbar-gutter:stable]"
  lang="ja"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={Astro.props.title} />
    <meta
      property="og:description"
      content={Astro.props.description || "AumyF's website"}
    />
    {
      image && (
        <>
          <meta property="og:image" content={image} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body class="">
    <div
      class="vstack min-h-screen max-w-6xl gap-4 selection:bg-[#00f] selection:text-white [--margin:clamp(_0.5rem,_max((100cqi_-_48rem)_/_2,_2.5cqi),_7.5cqi_)] mx-[var(--margin)]"
    >
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
<style is:global>
  @import "tailwindcss";

  /* remark-gfm injects class="sr-only" into rendered markdown (e.g. the
     footnotes heading) at build time, so Tailwind's content scan never sees
     the literal string and never generates the utility. Force it. */
  @source inline("sr-only");

  @layer components {
    .vstack {
      @apply flex flex-col;
    }
    .card {
      @apply border-l-2 border-black pl-4;
    }
  }

  @layer base {
    :root {
      font-family: sans-serif;
    }

    a {
      @apply underline decoration-[0.125em] hover:decoration-[0.166em] decoration-[#00f] underline-offset-4;
    }

    img {
      display: block;
      width: 100%;
    }
  }

  @media (prefers-color-scheme: dark) {
    .astro-code,
    .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
      /* Optional, if you also want font styles */
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
  }
</style>
