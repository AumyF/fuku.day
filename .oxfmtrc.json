{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "svelte": true,
  "astro": true,
  "ignorePatterns": ["dist/**", ".astro/**", "package-lock.json"],
  "overrides": [
    {
      "files": ["**/*.mdx"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
