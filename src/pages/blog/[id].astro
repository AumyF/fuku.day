---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

export const getStaticPaths = (async () => {
  const blog = await getCollection("blog");
  return blog.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const post = Astro.props.entry;

// const post = await getEntry("blog", Astro.params.id);
const rendered = await render(post);
const imageUrl = new URL(`/blog/${post.id}.png`, Astro.site).href;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={imageUrl}
>
  <div id="toc" popover class="peer z-50 m-auto bg-transparent p-2">
    <!-- TODO: iOSとかで出たり入ったりするナビゲーションでsvhが動いちゃうんだけどこれってsafe-area-insetでいいんだっけ？ -->
    <ul
      class="space-y-1 max-h-[50svh] p-2 overflow-scroll bg-[#fef1e2]/90 backdrop-blur border-2 border-[#06275e]"
    >
      {
        rendered.headings
          .filter((heading) => heading.slug !== "footnote-label")
          .map((heading) => {
            return (
              <li>
                {(() => {
                  switch (heading.depth) {
                    case 2:
                      return (
                        <a class={`block pl-2`} href={`#${heading.slug}`}>
                          {heading.text}
                        </a>
                      );
                    case 3:
                      return (
                        <a class={`block pl-4`} href={`#${heading.slug}`}>
                          {heading.text}
                        </a>
                      );
                    case 4:
                      return (
                        <a class={`block pl-6`} href={`#${heading.slug}`}>
                          {heading.text}
                        </a>
                      );
                  }
                })()}
              </li>
            );
          })
      }
    </ul>
  </div>

  <aside
    id="footnote-sheet"
    popover="auto"
    role="dialog"
    aria-modal="false"
    aria-label="脚注"
  >
    <div data-footnote-sheet-content>
      <span data-footnote-sheet-number aria-hidden="true"></span>
      <div data-footnote-sheet-body></div>
    </div>
    <header>
      <button
        type="button"
        popovertarget="footnote-sheet"
        popovertargetaction="hide"
        aria-label="脚注を閉じる"
      >
        閉じる
      </button>
    </header>
  </aside>

  <!-- 兄弟要素 -->
  <div
    class="w-fit z-50 fixed bottom-2 right-2 [--content:'開く'] peer-[&:popover-open]:[--content:'閉じる']"
  >
    <button
      popovertarget="toc"
      type="button"
      class="px-4 bg-[#fef1e2]/90 backdrop-blur border-2 border-[#06275e] after:[content:var(--content)] cursor-pointer"
      >目次
    </button>
  </div>

  <div
    class="grow px-2 [overflow-wrap:anywhere] max-w-[min(theme(maxWidth.3xl),100%)] border-x-2 border-[#06275e] [font-size:clamp(0.875rem,_0.792rem_+_0.42cqi,_1rem)]"
  >
    <article>
      <div>
        <p class="text-center mt-6">
          <code>@aumy_f, {post.id}:</code>
        </p>
        <p
          class="text-center font-mono w-10/12 mx-auto text-balance [word-break:auto-phrase]"
        >
          {post.data.description}
        </p>
        <hr class="border-[#06275e] border-t-2 block w-11/12 mx-auto mt-12" />
      </div>

      <h1
        class="text-3xl leading-normal font-bold text-right mt-6 pr-2 mb-4 [font-feature-settings:'palt'] text-pretty [word-break:auto-phrase]"
      >
        {post.data.title}
      </h1>

      <div id="content">
        <rendered.Content />
        <svg data-sidenote-connectors aria-hidden="true" ></svg>
      </div>
    </article>
  </div>

  <noscript>
    <style>
      #content .footnotes {
        display: block !important;
      }
      #content .sidenotes,
      #content [data-sidenote-connectors],
      #footnote-sheet {
        display: none !important;
      }
    </style>
  </noscript>

  <style>
    @reference "tailwindcss";

    #content :global(h2) {
      font-feature-settings: "palt";
      @apply text-2xl border-y-2 border-[#06275e] pl-2 my-4 -mx-2 font-bold leading-relaxed decoration-[oklch(0.72_0.1_0)];
    }
    #content :global(h3) {
      font-feature-settings: "palt";
      @apply text-xl my-3;
    }
    #content :global(h4) {
      font-feature-settings: "palt";
      @apply text-lg my-3;
    }
    #content :global(p + p) {
      @apply mt-3;
    }
    #content :global(hr) {
      @apply my-2 border-t border-[#06275e];
    }
    #content :global(ul) {
      @apply pl-6 list-disc;
    }
    #content :global(ol) {
      @apply pl-6 list-decimal;
    }
    #content :global(blockquote) {
      @apply pl-2 border-l-2 border-[#06275e];
    }
    #content :global(pre) {
      @apply px-4 py-2 my-3;
    }

    #content :global(em) {
      text-emphasis: dot;
      font-style: normal;
      margin-top: -1em;
      display: inline-block;
    }

    #content :global(figure) {
      @apply my-4;
    }
    #content :global(img + figcaption) {
      line-height: 1.5;
      font-size: 0.9em;
      text-align: center;
      text-wrap: balance;
      word-break: auto-phrase;
    }

    #content {
      --footnote-layout: narrow;
      position: relative;
    }

    #content :global(.footnotes) {
      display: none;
    }

    #content :global(.sidenotes),
    #content [data-sidenote-connectors] {
      display: none;
    }

    #footnote-sheet {
      inset: 0 0 auto;
      width: min(100%, 48rem);
      max-height: min(45svh, 24rem);
      margin: 0 auto;
      padding: 0;
      overflow: auto;
      background: rgb(254 241 226 / 0.96);
      border: 0;
      border-bottom: 2px solid #06275e;
      color: black;
      backdrop-filter: blur(0.75rem);
    }

    #footnote-sheet::backdrop {
      background: transparent;
    }

    #footnote-sheet header {
      position: sticky;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      padding: 0.5rem 0.75rem;
      background: rgb(254 241 226 / 0.96);
      border-top: 1px solid #06275e;
    }

    #footnote-sheet [data-footnote-sheet-number] {
      float: left;
      min-width: 1.5rem;
      margin-right: 0.25rem;
      font-variant-numeric: tabular-nums;
      font-weight: 700;
    }

    #footnote-sheet button {
      cursor: pointer;
      text-decoration: underline;
      text-decoration-color: #00f;
      text-decoration-thickness: 0.125em;
      text-underline-offset: 0.25rem;
    }

    #footnote-sheet [data-footnote-sheet-content] {
      padding: 0.75rem;
      overflow-wrap: anywhere;
    }

    #footnote-sheet :global(p + p) {
      margin-top: 0.75rem;
    }

    @container document (min-width: 72rem) {
      #content {
        --footnote-layout: wide;
      }

      #content :global(.sidenotes) {
        position: absolute;
        inset: 0 auto auto 100%;
        display: block;
        width: 0;
        height: 100%;
      }

      #content :global(.sidenote) {
        position: absolute;
        left: clamp(1rem, 2cqi, 2rem);
        width: var(--sidenote-rail-width, 10rem);
        min-width: 10rem;
        visibility: hidden;
        font-size: 0.875rem;
        line-height: 1.55;
      }

      #content[data-footnotes-ready] :global(.sidenote) {
        visibility: visible;
      }

      #content :global(.sidenote-number) {
        float: left;
        min-width: 1.5rem;
        margin-right: 0.25rem;
        font-variant-numeric: tabular-nums;
        font-weight: 700;
      }

      #content :global(.sidenote-body p + p) {
        margin-top: 0.5rem;
      }

      #content [data-sidenote-connectors] {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
        display: block;
        max-width: none;
        overflow: visible;
        pointer-events: none;
      }

      #content [data-sidenote-connectors] :global(path) {
        fill: none;
        stroke: #ff3588;
        stroke-width: 1px;
        opacity: 0.07;
        vector-effect: non-scaling-stroke;
        transition: opacity 120ms ease;
      }

      #content [data-sidenote-connectors] :global(path.is-active) {
        opacity: 0.55;
      }
    }

    @media print {
      #content :global(.footnotes) {
        display: block;
      }

      #content :global(.sidenotes),
      #content [data-sidenote-connectors],
      #footnote-sheet {
        display: none !important;
      }
    }
  </style>

  <script>
    const content = document.querySelector<HTMLElement>("#content");
    const sheet = document.querySelector<HTMLElement>("#footnote-sheet");

    if (content && sheet) {
      const references = Array.from(
        content.querySelectorAll<HTMLAnchorElement>("[data-footnote-ref]"),
      );
      const sidenotes = Array.from(
        content.querySelectorAll<HTMLElement>("[data-sidenote]"),
      );
      const connectors = content.querySelector<SVGSVGElement>(
        "[data-sidenote-connectors]",
      );
      const sheetContent = sheet.querySelector<HTMLElement>(
        "[data-footnote-sheet-content]",
      );
      const sheetNumber = sheet.querySelector<HTMLElement>(
        "[data-footnote-sheet-number]",
      );
      const sheetBody = sheet.querySelector<HTMLElement>(
        "[data-footnote-sheet-body]",
      );
      const sheetClose = sheet.querySelector<HTMLButtonElement>(
        "[popovertargetaction='hide']",
      );

      const footnoteId = (element: Element | null) =>
        element instanceof HTMLElement
          ? element.dataset.footnoteId
          : undefined;

      const isWide = () =>
        getComputedStyle(content)
          .getPropertyValue("--footnote-layout")
          .trim() === "wide";

      const referenceFor = (id: string) =>
        references.find((reference) => reference.dataset.footnoteId === id);

      const sidenoteFor = (id: string) =>
        sidenotes.find((sidenote) => sidenote.dataset.footnoteId === id);

      const syncActive = (id: string) => {
        const related = [
          ...references.filter(
            (reference) => reference.dataset.footnoteId === id,
          ),
          ...sidenotes.filter(
            (sidenote) => sidenote.dataset.footnoteId === id,
          ),
        ];
        const active = related.some(
          (element) =>
            element.matches(":hover") || element.matches(":focus-within"),
        );

        connectors
          ?.querySelectorAll<SVGPathElement>("path")
          .forEach((path) => {
            if (path.dataset.footnoteId === id) {
              path.classList.toggle("is-active", active);
            }
          });
      };

      let layoutFrame = 0;
      const layoutSidenotes = () => {
        layoutFrame = 0;

        if (!connectors) return;

        if (!isWide()) {
          content.removeAttribute("data-footnotes-ready");
          content.style.removeProperty("padding-bottom");
          connectors.replaceChildren();
          return;
        }

        if (sheet.matches(":popover-open")) sheet.hidePopover();

        const contentRect = content.getBoundingClientRect();
        const pageFrame = content.closest<HTMLElement>(".vstack");
        const frameRight =
          pageFrame?.getBoundingClientRect().right ?? contentRect.right;
        const sidenoteGap =
          Number.parseFloat(getComputedStyle(sidenotes[0]!).left) || 16;
        const railWidth = Math.max(
          160,
          frameRight - contentRect.right - sidenoteGap,
        );
        content.style.setProperty("--sidenote-rail-width", `${railWidth}px`);
        const currentPadding =
          Number.parseFloat(content.style.paddingBottom) || 0;
        const naturalHeight = content.scrollHeight - currentPadding;
        let previousBottom = -12;
        let widestPoint = contentRect.width;
        const paths: SVGPathElement[] = [];

        for (const sidenote of sidenotes) {
          const id = sidenote.dataset.footnoteId;
          if (!id) continue;
          const reference = referenceFor(id);
          if (!reference) continue;

          const referenceRect = reference.getBoundingClientRect();
          const referenceLineHeight =
            Number.parseFloat(getComputedStyle(reference).lineHeight) ||
            referenceRect.height;
          const upwardOffset = referenceLineHeight / 2;
          const desiredTop =
            referenceRect.top - contentRect.top - upwardOffset;
          const top = Math.max(desiredTop, previousBottom + 12);
          sidenote.style.top = `${top}px`;

          const sidenoteRect = sidenote.getBoundingClientRect();
          previousBottom = top + sidenoteRect.height;
          widestPoint = Math.max(
            widestPoint,
            sidenoteRect.right - contentRect.left,
          );

          const startX = referenceRect.right - contentRect.left + 3;
          const startY = referenceRect.top - contentRect.top + 2;
          const endX = sidenoteRect.left - contentRect.left - 6;
          const endY = sidenoteRect.top - contentRect.top + 2;
          const lineWidth = endX - startX;
          const lineRise = endY - startY;
          const waveAmplitude = Math.min(12, referenceLineHeight / 3);
          const firstControlX = startX + lineWidth / 3;
          const secondControlX = startX + (lineWidth * 2) / 3;
          const firstControlY = startY + lineRise / 3 + waveAmplitude;
          const secondControlY =
            startY + (lineRise * 2) / 3 - waveAmplitude;
          const path = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "path",
          );
          path.dataset.footnoteId = id;
          path.setAttribute(
            "d",
            `M ${startX} ${startY} C ${firstControlX} ${firstControlY}, ${secondControlX} ${secondControlY}, ${endX} ${endY}`,
          );
          paths.push(path);
        }

        const overflow = Math.max(0, previousBottom - naturalHeight);
        content.style.paddingBottom = overflow ? `${overflow}px` : "";
        const height = naturalHeight + overflow;
        connectors.setAttribute("width", `${widestPoint}`);
        connectors.setAttribute("height", `${height}`);
        connectors.style.width = `${widestPoint}px`;
        connectors.style.height = `${height}px`;
        connectors.replaceChildren(...paths);
        content.setAttribute("data-footnotes-ready", "");
      };

      const scheduleLayout = () => {
        if (layoutFrame) cancelAnimationFrame(layoutFrame);
        layoutFrame = requestAnimationFrame(layoutSidenotes);
      };

      content.addEventListener("pointerover", (event) => {
        const id = footnoteId(
          (event.target as Element).closest("[data-footnote-id]"),
        );
        if (id) requestAnimationFrame(() => syncActive(id));
      });
      content.addEventListener("pointerout", (event) => {
        const id = footnoteId(
          (event.target as Element).closest("[data-footnote-id]"),
        );
        if (id) requestAnimationFrame(() => syncActive(id));
      });
      content.addEventListener("focusin", (event) => {
        const id = footnoteId(
          (event.target as Element).closest("[data-footnote-id]"),
        );
        if (id) requestAnimationFrame(() => syncActive(id));
      });
      content.addEventListener("focusout", (event) => {
        const id = footnoteId(
          (event.target as Element).closest("[data-footnote-id]"),
        );
        if (id) requestAnimationFrame(() => syncActive(id));
      });

      content.addEventListener("click", (event) => {
        const reference = (event.target as Element).closest<HTMLAnchorElement>(
          "[data-footnote-ref]",
        );
        const id = reference?.dataset.footnoteId;
        if (!reference || !id) return;
        event.preventDefault();

        if (isWide()) {
          reference.focus({ preventScroll: true });
          syncActive(id);
          return;
        }

        const sidenote = sidenoteFor(id);
        const number = sidenote?.querySelector<HTMLElement>(".sidenote-number");
        const body = sidenote?.querySelector<HTMLElement>(".sidenote-body");
        if (!number || !body || !sheetContent || !sheetNumber || !sheetBody)
          return;

        sheet.setAttribute(
          "aria-label",
          sidenote?.getAttribute("aria-label") ?? "脚注",
        );
        sheetNumber.textContent = number.textContent;
        sheetBody.replaceChildren(...Array.from(body.childNodes, (node) =>
          node.cloneNode(true),
        ));
        sheet.dataset.returnFocus = reference.id;
        if (!sheet.matches(":popover-open")) sheet.showPopover();
        requestAnimationFrame(() =>
          sheetClose?.focus({ preventScroll: true }),
        );
      });

      sheet.addEventListener("toggle", (event) => {
        if ((event as ToggleEvent).newState !== "closed") return;
        const returnFocus = sheet.dataset.returnFocus;
        delete sheet.dataset.returnFocus;
        if (returnFocus) {
          document
            .getElementById(returnFocus)
            ?.focus({ preventScroll: true });
        }
      });

      if (references.length && sidenotes.length) {
        const resizeObserver = new ResizeObserver(scheduleLayout);
        resizeObserver.observe(document.documentElement);
        resizeObserver.observe(content);
        sidenotes.forEach((sidenote) => resizeObserver.observe(sidenote));
        document.fonts.ready.then(scheduleLayout);
        scheduleLayout();
      }
    }
  </script>
</Layout>
